# Copy this file to `.env` (same folder) and adjust the values.

# --- Django core -----------------------------------------------------------
DJANGO_DEBUG=True
# Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Where the Next.js frontend is opened from (comma separated).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database --------------------------------------------------------------
# Empty = SQLite file backend/db.sqlite3. PostgreSQL example:
#   DATABASE_URL=postgres://chat_user:chat_password@localhost:5432/chat_db
DATABASE_URL=

# --- Redis (cache, WebSocket channel layer, online status) -----------------
# Empty = in-memory (one process, development only). Example:
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Auth (optional, defaults shown) ----------------------------------------
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30
# AUTH_COOKIE_SECURE defaults to True when DJANGO_DEBUG=False (HTTPS only).
# AUTH_COOKIE_SECURE=
# AUTH_COOKIE_DOMAIN=
# Behind nginx (sets X-Forwarded-For) use 1, so rate limits work per client IP.
# DJANGO_NUM_PROXIES=0

# --- Chat upload limits in MB (optional, defaults shown) --------------------
# CHAT_MAX_IMAGE_MB=20
# CHAT_MAX_VIDEO_MB=100
# CHAT_MAX_AUDIO_MB=20
# CHAT_MAX_FILE_MB=100

# --- Production only (used when DJANGO_DEBUG=False) ------------------------
# nginx "internal" location for X-Accel-Redirect (nginx sends the files):
# MEDIA_ACCEL_REDIRECT_PREFIX=/protected-media/
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_HSTS_SECONDS=0
# DJANGO_TRUST_X_FORWARDED_PROTO=False

# --- Private chat ------------------------------------------------------------
# The start screen asks for this code (empty = anyone with the link can join).
# Share a link with it filled in: https://your-site/?invite=CODE
CHAT_INVITE_CODE=

# --- File storage (hosts without a permanent disk, e.g. Render free) --------
# S3-compatible storage, e.g. Cloudflare R2. Empty = files in backend/media/.
# S3_BUCKET=chat-media
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# Supabase Storage instead of R2 (no card needed):
#   S3_ENDPOINT_URL=https://<PROJECT_REF>.supabase.co/storage/v1/s3
#   S3_REGION=<project region, e.g. eu-central-1>
#   S3_ADDRESSING_STYLE=path
